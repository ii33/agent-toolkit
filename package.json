{
  "name": "@local/dsh-agentkit",
  "version": "1.4.8",
  "private": true,
  "type": "module",
  "description": "通用 agent 工具集（与翻译/模型无关）：编码换行字符集安全的文件读写（本地 + SFTP 远程代号与远程检索）、沙箱提权、argv 无 shell 运行器、bash 与 PowerShell 7、镜像加速装依赖、外网代理探测、文档 OCR/合并/打包、大文件拆块、图片读取与裁剪、任务面板、预设管理，以及结构化禁用 Windows PowerShell 5.1；其 generic 预设另外挂载 DSH 出货的 glob/grep 检索、询问用户与计划模式",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "agent-preset",
    "filesystem",
    "sftp",
    "proxy",
    "mirror",
    "windows",
    "encoding"
  ],
  "license": "MIT",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "lib/",
    "tools/",
    "locale/",
    "icon.svg",
    "cordis.patch.yml",
    "presets.generated.patch.yml",
    "presets.generated.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets.generated.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/schemastery": ">=3.18.4 <3.19"
  }
}
